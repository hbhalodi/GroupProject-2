# Copy this file to .env and fill in what you need. Never commit .env.

# ---- Which model Golu uses (can also be set with --provider / --model) ----
GOLU_PROVIDER=ollama            # ollama | groq | openai | anthropic
# GOLU_MODEL=                   # leave empty for the provider default below
GOLU_MODE=confirm               # confirm | auto

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b   # must support tool calling
OLLAMA_NUM_CTX=16384

# ---- Groq (cloud, free tier: https://console.groq.com/keys) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # check console.groq.com/docs/models for current names

# ---- Optional providers ----
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- External MCP servers ----
# Optional, free at https://context7.com/dashboard (raises the rate limit)
CONTEXT7_API_KEY=
# Only needed if you enable "tavily" in mcp_config.json
TAVILY_API_KEY=

# ---- RAG server ----
RAG_EMBED_MODEL=nomic-embed-text
RAG_MODE=fusion                 # fusion (advanced) | vector (baseline)
RAG_FUSION_ALPHA=0.5            # 1.0 = vector only, 0.0 = keyword only

# ---- Agent limits ----
GOLU_MAX_STEPS=25
GOLU_SHELL_TIMEOUT=120
